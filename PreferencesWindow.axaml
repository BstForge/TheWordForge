<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="TheWordForge.PreferencesWindow"
        MinWidth="300" MinHeight="150" SizeToContent="WidthAndHeight"
        Title="Preferences">
    <StackPanel Margin="10">
        <ToggleSwitch Content="Transitions On/Off" IsChecked="{Binding TransitionsEnabled}" Margin="0,0,0,10"/>
        <Button Content="OK" HorizontalAlignment="Right" Click="ClosePreferences"/>
    </StackPanel>
</Window>
